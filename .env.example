# Copy to .env and load it in your shell (the app reads environment variables).
DATA_DIR=data/production
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_IDS=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=
MONITOR_SECONDS=3600
# Full OpenAI-compatible chat endpoint. Local inference: http://127.0.0.1:.../v1/chat/completions
LLM_URL=
LLM_API_KEY=
LLM_MODEL=
# Operator-supplied, authorised NSPD adapter. POST JSON contract: docs/integrations.md
NSPD_ADAPTER_URL=
NSPD_API_KEY=
# Image adapter with optional reference_image_base64, PNG b64_json response.
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
